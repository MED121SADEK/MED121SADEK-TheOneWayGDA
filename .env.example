# ============================================
# The One-Way — Environment Variables
# Copy this file to .env.local and fill values
# ============================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
DIRECT_DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://theonewaygda.com"
NEXTAUTH_SECRET="your-secret-key-here"

# ── REQUIRED for User Acceptance System ──
# Admin password for /admin/visitors page (Method 3)
ADMIN_SECRET="your-secure-admin-password"

# ── Email Notifications (User Acceptance) ──
# Your email address where you receive new user notifications
# Supports: Outlook, Hotmail, Live, Gmail, or any custom SMTP
ADMIN_EMAIL="your-email@outlook.com"

# App Password for sending emails
#   Microsoft: https://account.live.com/proofs/manage/additional
#   Gmail:     https://myaccount.google.com/apppasswords
ADMIN_EMAIL_APP_PASSWORD="your-app-password"

# Optional: AI SDK (z-ai-web-dev-sdk)
ZAI_API_KEY="your-zai-api-key"

# Optional: GitHub OAuth
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"

# Optional: Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="google465d22e5febc4e42.html"

# Redis — Distributed rate limiting (P1-5)
# When set, rate limits are shared across all serverless instances.
# When absent, rate limiting falls back to in-memory (single-instance).
#
# Option A: Upstash Redis (recommended for Vercel/serverless)
#   UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
#   UPSTASH_REDIS_REST_TOKEN="Axxx..."
#
# Option B: Self-hosted Redis (for Docker / VPS deployments)
#   REDIS_URL="redis://localhost:6379"
#   REDIS_URL="rediss://user:pass@redis-host:6379"  (TLS)
REDIS_URL="redis://localhost:6379"

# Optional: Stripe (for billing)
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"

# Optional: Custom SMTP (overrides auto-detection)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-email-password"
