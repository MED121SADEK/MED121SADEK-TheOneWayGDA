# ═══════════════════════════════════════════════════════════
# THEONEWAYGDA — Production Environment Variables
# Copy to Vercel → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Core ──
NEXTAUTH_URL=https://theonewaygda.com
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# ── Database (Vercel Postgres) ──
# Get from: https://vercel.com/theonewaygda/stores → Postgres → .env.local
DATABASE_URL=postgres://default:<password>@<host>:5432/<db>?sslmode=require
DIRECT_DATABASE_URL=postgres://default:<password>@<host>:5432/<db>?sslmode=require&pgbouncer=true

# ── Edge Config ──
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_v1h7tl7r72ak3dqwnsbvtxbmatcj?token=0c598614-7fe2-4819-8c76-4c1c71493ab6

# ── Google Search Console ──
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google465d22e5febc4e42.html

# ── Optional: Auth Providers ──
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional: AI SDK ──
# ZAI_API_KEY=

# ── Optional: Stripe ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Optional: SMTP ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
